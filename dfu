<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مزاج اليوم - فرع 2</title>
    <!-- استيراد خط تجوال العصري -->
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <!-- أيقونات FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
        }

        body {
            background-color: #0b0f19;
            color: #f3f4f6;
            padding-bottom: 130px;
        }

        header {
            background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
            padding: 30px 20px;
            text-align: center;
            border-bottom: 4px solid #eab308;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        header h1 {
            font-size: 2.2rem;
            color: #ffffff;
            margin-bottom: 8px;
            font-weight: 900;
            letter-spacing: 1px;
        }

        header p {
            color: #9ca3af;
            font-size: 1rem;
        }

        .container {
            max-width: 1200px;
            margin: 25px auto;
            padding: 0 15px;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
            gap: 20px;
        }

        .menu-card {
            background: #161e2e;
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid #1f2937;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 6px 15px rgba(0,0,0,0.3);
        }

        .menu-card:hover {
            transform: translateY(-6px);
            border-color: #eab308;
            box-shadow: 0 12px 30px rgba(234, 179, 8, 0.2);
        }

        .card-header {
            position: relative;
            background: #1f2937;
            padding: 18px 15px;
            text-align: center;
            border-bottom: 1px solid #374151;
        }

        .price-tag {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #eab308;
            color: #0b0f19;
            font-weight: 900;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.95rem;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }

        .card-header h3 {
            font-size: 1.2rem;
            color: #ffffff;
            margin-top: 12px;
            font-weight: 700;
        }

        .card-body {
            padding: 18px 15px;
            text-align: center;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .calories {
            color: #9ca3af;
            font-size: 0.88rem;
            margin-bottom: 15px;
            background: #1f2937;
            display: inline-block;
            padding: 4px 12px;
            border-radius: 8px;
            align-self: center;
            border: 1px solid #374151;
        }

        .add-btn {
            background: #2563eb;
            color: white;
            border: none;
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 1rem;
        }

        .add-btn:hover {
            background: #1d4ed8;
        }

        .add-btn.added {
            background: #16a34a;
        }

        /* شريط سلة الطلبات العائمة */
        .cart-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: #161e2e;
            border-top: 3px solid #eab308;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 -8px 30px rgba(0,0,0,0.7);
            z-index: 1000;
        }

        .cart-info {
            font-size: 1.15rem;
            font-weight: 700;
        }

        .cart-info span {
            color: #eab308;
        }

        .whatsapp-btn {
            background: #22c55e;
            color: #fff;
            border: none;
            padding: 14px 28px;
            border-radius: 14px;
            font-weight: 900;
            font-size: 1.05rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: transform 0.2s, background 0.2s;
            text-decoration: none;
            box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
        }

        .whatsapp-btn:hover {
            background: #16a34a;
            transform: scale(1.03);
        }

        .delivery-info {
            text-align: center;
            margin: 15px 0 25px;
            color: #9ca3af;
            font-size: 1rem;
            background: #161e2e;
            padding: 12px;
            border-radius: 12px;
            border: 1px solid #1f2937;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
        }

        .delivery-info i {
            color: #eab308;
            margin-left: 8px;
        }
    </style>
</head>
<body>

    <header>
        <h1>مزاج اليوم (فرع 2)</h1>
        <p>قائمة الوجبات السريعة - اطلب بسهولة عبر الواتساب</p>
    </header>

    <div class="container">
        <div class="delivery-info">
            <i class="fa-solid fa-phone-volume"></i> خدمة التوصيل: <strong>0595804974</strong>
        </div>

        <div class="menu-grid" id="menuGrid">
            <!-- سيتم توليد الوجبات برمجياً هنا -->
        </div>
    </div>

    <!-- شريط سلة الطلبات -->
    <div class="cart-bar">
        <div class="cart-info">
            الإجمالي: <span id="totalPrice">0</span> ر.س | الأصناف: <span id="totalCount">0</span>
        </div>
        <button class="whatsapp-btn" onclick="sendToWhatsApp()">
            <i class="fa-brands fa-whatsapp fa-lg"></i> إرسال الطلب للواتساب
        </button>
    </div>

    <script>
        // المنيو الدقيق والمطابق تماماً للصورة بدون أي تغيير
        const menuItems = [
            { id: 1, name: "وجبة برجر زنجر", price: 17, calories: "496 سعرة" },
            { id: 2, name: "وجبة برجر دجاج", price: 14, calories: "561 سعرة" },
            { id: 3, name: "وجبة برجر لحم", price: 14, calories: "584 سعرة" },
            { id: 4, name: "وجبة برجر مشوي طازج", price: 22, calories: "820 سعرة" },
            { id: 5, name: "برجر فلفل حار أمريكانا", price: 19, calories: "691 سعرة" },
            { id: 6, name: "برجر دجاج دبل أمريكانا", price: 18, calories: "714 سعرة" },
            { id: 7, name: "وجبة برجر دجاج طازج", price: 17, calories: "459 سعرة" },
            { id: 8, name: "وجبة برجر لحم طازج", price: 22, calories: "426 سعرة" },
            { id: 9, name: "وجبة برجر مشوي سبايسي", price: 22, calories: "462 سعرة" },
            { id: 10, name: "صحن مسحب وجبة", price: 15, calories: "912 سعرة" },
            { id: 11, name: "برجر دجاج طازج (دبل)", price: 25, calories: "659 سعرة" },
            { id: 12, name: "برجر غنم طازج (دبل)", price: 31, calories: "748 سعرة" },
            { id: 13, name: "وجبة برجر دبل زنجر", price: 23, calories: "922 سعرة" },
            { id: 14, name: "فاهيتا كودو زنجر", price: 17, calories: "516 سعرة" },
            { id: 15, name: "فاهيتا كودو لحم طازج", price: 22, calories: "598 سعرة" },
            { id: 16, name: "فاهيتا كودو دجاج", price: 17, calories: "573 سعرة" },
            { id: 17, name: "صحن جمبري وجبة", price: 20, calories: "349 سعرة" },
            { id: 18, name: "فاهيتا كودو جمبري", price: 16, calories: "612 سعرة" },
            { id: 19, name: "وجبة فاهيتا كودو مسحب", price: 14, calories: "596 سعرة" },
            { id: 20, name: "تورتيلا دجاج", price: 17, calories: "566 سعرة" },
            { id: 21, name: "تورتيلا جمبري", price: 16, calories: "510 سعرة" },
            { id: 22, name: "تورتيلا زنجر", price: 17, calories: "598 سعرة" },
            { id: 23, name: "وجبة مسحب تورتيلا", price: 14, calories: "624 سعرة" }
        ];

        let cart = {};

        const menuGrid = document.getElementById('menuGrid');
        const totalPriceEl = document.getElementById('totalPrice');
        const totalCountEl = document.getElementById('totalCount');

        function renderMenu() {
            menuGrid.innerHTML = '';
            menuItems.forEach(item => {
                const qty = cart[item.id] || 0;
                const card = document.createElement('div');
                card.className = 'menu-card';
                card.innerHTML = `
                    <div class="card-header">
                        <div class="price-tag">${item.price} ر.س</div>
                        <h3>${item.name}</h3>
                    </div>
                    <div class="card-body">
                        <div class="calories"><i class="fa-solid fa-fire"></i> ${item.calories}</div>
                        <button class="add-btn ${qty > 0 ? 'added' : ''}" onclick="updateCart(${item.id}, 1)">
                            <i class="fa-solid ${qty > 0 ? 'fa-check' : 'fa-plus'}"></i> ${qty > 0 ? 'تم الإضافة (' + qty + ')' : 'إضافة للطلب'}
                        </button>
                    </div>
                `;
                menuGrid.appendChild(card);
            });
        }

        function updateCart(id, change) {
            if (!cart[id]) cart[id] = 0;
            cart[id] += change;
            if (cart[id] <= 0) delete cart[id];
            renderMenu();
            updateSummary();
        }

        function updateSummary() {
            let total = 0;
            let count = 0;
            for (let id in cart) {
                const item = menuItems.find(i => i.id == id);
                total += item.price * cart[id];
                count += cart[id];
            }
            totalPriceEl.textContent = total;
            totalCountEl.textContent = count;
        }

        function sendToWhatsApp() {
            let count = Object.values(cart).reduce((a, b) => a + b, 0);
            if (count === 0) {
                alert('الرجاء اختيار وجبة واحدة على الأقل قبل الإرسال!');
                return;
            }

            let message = "السلام عليكم، هذا طلب جديد من مزاج اليوم (فرع 2):\n\n";
            let total = 0;

            for (let id in cart) {
                const item = menuItems.find(i => i.id == id);
                let itemTotal = item.price * cart[id];
                total += itemTotal;
                message += `- ${item.name} (العدد: ${cart[id]}) - ${itemTotal} ر.س\n`;
            }

            message += `\nالإجمالي الكلي: ${total} ريال`;

            const phone = "966595804974"; // رقم التوصيل
            const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
            window.open(url, '_blank');
        }

        renderMenu();
    </script>
</body>
</html>
