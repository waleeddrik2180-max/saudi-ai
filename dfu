        });

        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        function filterMenu(category) {
            const items = document.querySelectorAll('.menu-item');
            const tabs = document.querySelectorAll('.menu-tab');

            tabs.forEach(tab => {
                tab.classList.remove('bg-emerald-600', 'text-white');
                tab.classList.add('bg-oceanDark/80', 'text-slate-200');
            });
            event.target.classList.remove('bg-oceanDark/80', 'text-slate-200');
            event.target.classList.add('bg-emerald-600', 'text-white');

            items.forEach(item => {
                if (category === 'all' || item.getAttribute('data-category') === category) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
